        "failureCategory": { "$ref": "#/$defs/OffsetFailureCategory" },
        "directionSign": { "type": "integer", "enum": [-1, 1] },
        "offsetDistanceCm": { "type": "number", "minimum": 0.0 },
        "minBaseSpeedSquaredQ": { "type": "number", "minimum": 0.0 },
        "minOffsetSpeedFactorF": { "type": "number" },
        "hasZeroSpeedCuspOnDomain": { "type": "boolean" },
        "hasTangentReversalOnDomain": { "type": "boolean" },
        "gridErrorCm": { "type": "number", "minimum": 0.0 },
        "certifiedIntervalErrorCm": { "type": "number", "minimum": 0.0 },
        "maxJoinTangentDeltaDeg": { "type": "number", "minimum": 0.0 },
        "reparameterized": { "type": "boolean" },
        "trimmed": { "type": "boolean" },
        "isolatedRoots": {
          "type": "array",
          "items": { "$ref": "#/$defs/RootBracketCertificate" }
        },
        "oracleTierUsed": {
          "type": "string",
          "enum": ["C1-Fast", "C1-Cert-53bit", "C1-Cert-113bit-Q", "C1-Cert-170bit-Q", "C1-Cert-336bit-Q"]
        },
        "isProductionReady": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verificationOutcome": { "const": "CERTIFIED_VALID" } },
            "required": ["verificationOutcome"]
          },
          "then": {
            "properties": {
              "failureCategory": { "const": "NONE" },
              "canonicalOffsetClassification": { "const": "CERTIFIED_VALID" },
              "activeClassificationsOnDomain": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "const": "CERTIFIED_VALID" }
              },
              "baseCurveSingularityClassification": {
                "enum": [
                  "REGULAR_BASE_CURVE",
                  "REMOVABLE_PARAMETERIZATION_DEGENERACY",
                  "ENDPOINT_TANGENTIAL_DEGENERACY"
                ]
              },
              "hasZeroSpeedCuspOnDomain": { "const": false },
              "hasTangentReversalOnDomain": { "const": false },
              "minOffsetSpeedFactorF": { "minimum": 0.05 },
              "isolatedRoots": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "verificationOutcome": { "const": "CERTIFIED_INVALID" } },
            "required": ["verificationOutcome"]
          },
          "then": {
            "properties": {
              "failureCategory": { "not": { "enum": ["NONE", "INCONCLUSIVE_VERIFICATION"] } },
              "canonicalOffsetClassification": { "not": { "enum": ["CERTIFIED_VALID", "INCONCLUSIVE"] } },
              "isProductionReady": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": { "verificationOutcome": { "const": "INCONCLUSIVE" } },
            "required": ["verificationOutcome"]
          },
          "then": {
            "properties": {
              "failureCategory": { "const": "INCONCLUSIVE_VERIFICATION" },
              "canonicalOffsetClassification": { "const": "INCONCLUSIVE" },
              "activeClassificationsOnDomain": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "const": "INCONCLUSIVE" }
              },
              "isProductionReady": { "const": false }
            }
          }
        }
      ]
