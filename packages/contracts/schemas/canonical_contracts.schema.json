{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patroner.io/schemas/v1/canonical_contracts.schema.json",
  "title": "PatronerCanonicalContractsV1",
  "description": "Canonical M00.1 JSON Schema Draft 2020-12 contracts enforcing ADR-002, ADR-003, ADR-005, and ADR-009 (R2.1.2-R1). IMPORTANT (L-03): JSON Schema Draft 2020-12 acceptance alone is NOT complete contract certification; consumers MUST also execute the paired runtime cross-field numeric validator (Pydantic v2 in Python or packages/contracts/src/cross-field-validators.ts in TypeScript) for the 4 cross-field numeric inequalities beyond Draft 2020-12 native expressiveness.",
  "x-validationBoundary": {
    "jsonSchemaAcceptanceAloneIsCompleteCertification": false,
    "nativeExpressivenessScope": "All structural, type, enum, range, and 16 discrete/conditional contradictory certification state invariants.",
    "runtimeCrossFieldNumericInequalitiesRequired": [
      "OffsetValidationRecord: verification_outcome == 'CERTIFIED_VALID' => min_offset_speed_factor_interval[0] >= regularity_margin_epsilon",
      "OffsetValidationRecord: min_base_speed_squared_interval[1] >= min_base_speed_squared_interval[0]",
      "OffsetValidationRecord: min_offset_speed_factor_interval[1] >= min_offset_speed_factor_interval[0]",
      "OffsetClassificationReport: gridErrorCm <= certifiedIntervalErrorCm"
    ],
    "pairedRuntimeValidators": {
      "python": "services/geometry-engine/patroner_geometry/contracts.py",
      "typescript": "packages/contracts/src/cross-field-validators.ts"
    }
  },
  "type": "object",
  "$defs": {
    "Point2D": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "description": "X coordinate in cm (right-handed Cartesian plane)" },
        "y": { "type": "number", "description": "Y coordinate in cm (right-handed Cartesian plane)" }
      }
    },
    "CoordinateFrameSpec": {
      "type": "object",
      "required": [
        "geometryUnit",
        "clearanceUnit",
        "internalAngleUnit",
        "displayAngleUnit",
        "handedness",
        "exteriorWinding",
        "interiorCutoutWinding",
        "leftNormalDirectionOnExterior"
      ],
      "additionalProperties": false,
      "properties": {
        "geometryUnit": { "const": "cm" },
        "clearanceUnit": { "const": "mm" },
        "internalAngleUnit": { "const": "rad" },
        "displayAngleUnit": { "const": "deg" },
        "handedness": { "const": "right-handed-cartesian" },
        "exteriorWinding": { "const": "CCW" },
        "interiorCutoutWinding": { "const": "CW" },
        "leftNormalDirectionOnExterior": { "const": "inward" }
      }
    },
    "BezierSegment": {
      "type": "object",
      "required": ["id", "p0", "p1", "p2", "p3"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "p0": { "$ref": "#/$defs/Point2D" },
        "p1": { "$ref": "#/$defs/Point2D" },
        "p2": { "$ref": "#/$defs/Point2D" },
        "p3": { "$ref": "#/$defs/Point2D" }
      }
    },
    "CanonicalOffsetClassification": {
      "type": "string",
      "description": "ADR-009 §4.3-4.4 Six Canonical Offset Classifications plus CERTIFIED_VALID when no failure occurs.",
      "enum": [
        "CERTIFIED_VALID",
        "REGULARITY_MARGIN_VIOLATION",
        "ACTUAL_OFFSET_SINGULARITY / ZERO_SPEED_CUSP",
        "TANGENT_REVERSAL",
        "LOCAL_SELF_INTERSECTION",
        "GLOBAL_SELF_INTERSECTION",
        "INCONCLUSIVE"
      ]
    },
    "BaseCurveSingularityClassification": {
      "type": "string",
      "description": "ADR-009 §2.2 & §4.2 Separate 5-Way Base-Curve Singularity Classification where Q(t*) = 0.",
      "enum": [
        "REGULAR_BASE_CURVE",
        "GENUINE_ZERO_SPEED_GEOMETRIC_CUSP_OR_FOLD",
        "REMOVABLE_PARAMETERIZATION_DEGENERACY",
        "ENDPOINT_TANGENTIAL_DEGENERACY",
        "COLLAPSED_ZERO_LENGTH_CURVE"
      ]
    },
    "StationaryParameterizationStatus": {
      "type": "string",
      "description": "ADR-009 §5.3 & §4.2 stationary_parameterization_status enum for OffsetValidationRecord (includes UNRESOLVED alongside §4.2 5-way states).",
      "enum": [
        "NONE_REGULAR_SPEED",
        "REMOVABLE_PARAMETERIZATION_DEGENERACY",
        "GENUINE_BASE_GEOMETRIC_SINGULARITY",
        "ENDPOINT_TANGENTIAL_DEGENERACY",
        "COLLAPSED_ZERO_LENGTH_CURVE",
        "UNRESOLVED"
      ]
    },
    "OffsetFailureCategory": {
      "type": "string",
      "description": "ADR-009 §5.3 exact 7-value failure_category enum for OffsetValidationRecord and OffsetClassificationReport.",
      "enum": [
        "NONE",
        "REGULARITY_MARGIN_VIOLATION",
        "ACTUAL_ZERO_SPEED_CUSP",
        "TANGENT_REVERSAL",
        "LOCAL_OFFSET_SELF_INTERSECTION",
        "GLOBAL_CONTOUR_SELF_INTERSECTION",
        "INCONCLUSIVE_VERIFICATION"
      ]
    },
    "SeamAllowance": {
      "type": "object",
      "required": ["segmentId", "distanceCm", "directionSign", "joinStyle", "miterLimit"],
      "additionalProperties": false,
      "properties": {
        "segmentId": { "type": "string", "minLength": 1 },
        "distanceCm": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
        "directionSign": {
          "type": "integer",
          "enum": [-1, 1],
          "description": "+1 along +N_+(t) (inward on CCW exterior contour); -1 along -N_+(t) (outward seam allowance on CCW exterior contour)"
        },
        "joinStyle": { "type": "string", "enum": ["miter", "bevel", "round", "fold"] },
        "miterLimit": { "type": "number", "minimum": 1.0, "maximum": 10.0 }
      }
    },
    "SeamAllowanceSpec": {
      "$ref": "#/$defs/SeamAllowance"
    },
    "Notch": {
      "type": "object",
      "required": ["id", "segmentId", "targetArcLengthCm", "parameterT", "position", "normalVector", "notchType"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "segmentId": { "type": "string", "minLength": 1 },
        "targetArcLengthCm": { "type": "number", "minimum": 0.0 },
        "parameterT": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "position": { "$ref": "#/$defs/Point2D" },
        "normalVector": { "$ref": "#/$defs/Point2D" },
        "notchType": { "type": "string", "enum": ["slit", "v-notch", "t-notch", "double"] },
        "arcLengthResidualCm": { "type": "number", "minimum": 0.0, "maximum": 1e-7 }
      }
    },
    "NotchSpec": {
      "$ref": "#/$defs/Notch"
    },
    "RootBracketCertificate": {
      "type": "object",
      "required": ["tLower", "tUpper", "deltaT", "maxSpeedOnBracket", "deltaPosCm", "multiplicityOrOrder"],
      "additionalProperties": false,
      "properties": {
        "tLower": { "type": "number", "minimum": -1.0, "maximum": 2.0 },
        "tUpper": { "type": "number", "minimum": -1.0, "maximum": 2.0 },
        "deltaT": { "type": "number", "minimum": 0.0, "maximum": 1e-12 },
        "maxSpeedOnBracket": { "type": "number", "minimum": 0.0 },
        "deltaPosCm": { "type": "number", "minimum": 0.0, "maximum": 1e-7 },
        "multiplicityOrOrder": { "type": "string", "minLength": 1 }
      }
    },
    "SelfIntersectionCertificate": {
      "type": "object",
      "required": [
        "scope",
        "segmentIdA",
        "segmentIdB",
        "t1Bracket",
        "t2Bracket",
        "intersectionPointCm",
        "residualDistanceCm"
      ],
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "string", "enum": ["LOCAL", "GLOBAL"] },
        "segmentIdA": { "type": "string", "minLength": 1 },
        "segmentIdB": { "type": "string", "minLength": 1 },
        "t1Bracket": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "t2Bracket": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "intersectionPointCm": { "$ref": "#/$defs/Point2D" },
        "residualDistanceCm": { "type": "number", "minimum": 0.0, "maximum": 1e-6 }
      }
    },
    "ParameterEnclosureRecord": {
      "type": "object",
      "required": ["t_lower", "t_upper", "t_mid", "r_param"],
      "additionalProperties": false,
      "properties": {
        "t_lower": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "t_upper": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "t_mid": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "r_param": { "type": "number", "minimum": 0.0 },
        "residual_interval_lower": { "type": ["number", "null"] },
        "residual_interval_upper": { "type": ["number", "null"] }
      }
    },
    "OutputPropagationRecord": {
      "type": "object",
      "required": [
        "propagation_method",
        "point_evaluation_rounding_bound_delta_eval",
        "output_enclosure_radius_b_ref_x"
      ],
      "additionalProperties": false,
      "properties": {
        "propagation_method": {
          "type": "string",
          "enum": [
            "NONE_DIRECT_ENCLOSURE",
            "METHOD_B1_VALIDATED_DERIVATIVE",
            "METHOD_B2_DIRECT_INTERVAL_IMAGE"
          ]
        },
        "derivative_upper_bound_m": { "type": ["number", "null"], "minimum": 0.0 },
        "point_evaluation_rounding_bound_delta_eval": { "type": "number", "minimum": 0.0 },
        "output_enclosure_radius_b_ref_x": { "type": "number", "minimum": 0.0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "propagation_method": { "const": "METHOD_B1_VALIDATED_DERIVATIVE" } },
            "required": ["propagation_method"]
          },
          "then": {
            "required": ["derivative_upper_bound_m"],
            "properties": { "derivative_upper_bound_m": { "type": "number", "minimum": 0.0 } }
          }
        }
      ]
    },
    "NumericalErrorComponents": {
      "type": "object",
      "required": [
        "x_float64",
        "x_ref",
        "observed_discrepancy_e_obs",
        "reference_enclosure_b_ref",
        "implementation_to_exact_bound_b_cert",
        "output_propagation"
      ],
      "additionalProperties": false,
      "properties": {
        "x_float64": { "type": "number" },
        "x_ref": { "type": "number" },
        "observed_discrepancy_e_obs": { "type": "number", "minimum": 0.0 },
        "reference_enclosure_b_ref": { "type": "number", "minimum": 0.0 },
        "implementation_to_exact_bound_b_cert": { "type": "number", "minimum": 0.0 },
        "heuristic_error_estimate": { "type": ["number", "null"], "minimum": 0.0 },
        "parameter_enclosure": {
          "anyOf": [{ "$ref": "#/$defs/ParameterEnclosureRecord" }, { "type": "null" }]
        },
        "output_propagation": { "$ref": "#/$defs/OutputPropagationRecord" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "parameter_enclosure": { "type": "object" } },
            "required": ["parameter_enclosure"]
          },
          "then": {
            "properties": {
              "output_propagation": {
                "properties": {
                  "propagation_method": {
                    "enum": ["METHOD_B1_VALIDATED_DERIVATIVE", "METHOD_B2_DIRECT_INTERVAL_IMAGE"]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "NumericalReproducibilityManifest": {
      "type": "object",
      "required": ["python_version", "mpmath_version", "subdivision_depth_k", "input_fixture_sha256"],
      "additionalProperties": false,
      "properties": {
        "python_version": { "type": "string", "minLength": 1 },
        "mpmath_version": { "type": "string", "minLength": 1 },
        "subdivision_depth_k": { "type": "integer", "minimum": 0 },
        "input_fixture_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "NumericalVerificationRecord": {
      "type": "object",
      "description": "ADR-009 §2.5 Mandatory Numerical Verification Record separating parameter uncertainty delta_t from geometric error.",
      "required": [
        "curve_id",
        "operation_type",
        "parameter_bracket_t",
        "parameter_uncertainty_dt",
        "local_speed_upper_bound_cm_per_t",
        "propagated_position_error_cm",
        "direct_geometric_error_bound_cm",
        "propagation_method",
        "working_precision_bits",
        "adaptive_subdivision_panels",
        "certified_within_tolerance",
        "quantity_name",
        "reference_method_and_version",
        "precision_and_arithmetic_model",
        "enclosure_or_remainder_method",
        "assurance_classification",
        "error_components",
        "acceptance_tolerance_tau",
        "verification_outcome",
        "reproducibility_manifest"
      ],
      "additionalProperties": false,
      "properties": {
        "curve_id": { "type": "string", "minLength": 1 },
        "operation_type": {
          "type": "string",
          "enum": [
            "ARC_LENGTH",
            "INVERSE_ARC_LENGTH",
            "OFFSET_CURVE",
            "CURVE_INTERSECTION",
            "ROOT_ISOLATION"
          ]
        },
        "parameter_bracket_t": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "parameter_uncertainty_dt": { "type": "number", "minimum": 0.0, "maximum": 1e-12 },
        "local_speed_upper_bound_cm_per_t": { "type": "number", "minimum": 0.0 },
        "propagated_position_error_cm": { "type": "number", "minimum": 0.0 },
        "direct_geometric_error_bound_cm": { "type": "number", "minimum": 0.0 },
        "propagation_method": {
          "type": "string",
          "enum": [
            "B1_FIRST_ORDER_UPPER_BOUND",
            "B2_INTERVAL_IMAGE_ENCLOSURE",
            "C1_CERT_CHORD_POLYGON_BOUNDS"
          ]
        },
        "working_precision_bits": { "type": "integer", "minimum": 53, "maximum": 336 },
        "adaptive_subdivision_panels": { "type": "integer", "minimum": 1 },
        "certified_within_tolerance": { "type": "boolean" },
        "quantity_name": { "type": "string", "minLength": 1 },
        "reference_method_and_version": { "type": "string", "minLength": 1 },
        "precision_and_arithmetic_model": { "type": "string", "minLength": 1 },
        "enclosure_or_remainder_method": { "type": "string", "minLength": 1 },
        "assurance_classification": {
          "type": "string",
          "enum": [
            "CERTIFIED_ENCLOSURE",
            "HIGH_PRECISION_NUMERICAL_REFERENCE",
            "CONSERVATIVE_ENGINEERING_ESTIMATE"
          ]
        },
        "error_components": { "$ref": "#/$defs/NumericalErrorComponents" },
        "acceptance_tolerance_tau": { "type": "number", "exclusiveMinimum": 0.0 },
        "verification_outcome": {
          "type": "string",
          "enum": ["CERTIFIED_VALID", "CERTIFIED_INVALID", "INCONCLUSIVE"]
        },
        "reproducibility_manifest": { "$ref": "#/$defs/NumericalReproducibilityManifest" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verification_outcome": { "const": "CERTIFIED_VALID" } },
            "required": ["verification_outcome"]
          },
          "then": {
            "properties": { "certified_within_tolerance": { "const": true } }
          }
        },
        {
          "if": {
            "properties": { "verification_outcome": { "enum": ["CERTIFIED_INVALID", "INCONCLUSIVE"] } },
            "required": ["verification_outcome"]
          },
          "then": {
            "properties": { "certified_within_tolerance": { "const": false } }
          }
        }
      ]
    },
    "OffsetValidationRecord": {
      "type": "object",
      "description": "ADR-009 §5.3 Mandatory Offset Validation Record produced by the C1-Cert oracle. JSON Schema enforces all structural, enum, and discrete conditional certification states; runtime consumers MUST additionally enforce the 3 cross-field numeric inequalities listed in x-crossFieldNumericInvariants via Pydantic v2 or packages/contracts/src/cross-field-validators.ts.",
      "x-crossFieldNumericInvariants": [
        "min_base_speed_squared_interval[1] >= min_base_speed_squared_interval[0]",
        "min_offset_speed_factor_interval[1] >= min_offset_speed_factor_interval[0]",
        "verification_outcome == 'CERTIFIED_VALID' => min_offset_speed_factor_interval[0] >= regularity_margin_epsilon"
      ],
      "required": [
        "segment_id",
        "piece_id",
        "contour_orientation",
        "coordinate_convention",
        "offset_direction_sign_s",
        "offset_distance_cm",
        "regularity_margin_epsilon",
        "min_base_speed_squared_interval",
        "min_offset_speed_factor_interval",
        "has_zero_speed_cusp_on_domain",
        "has_tangent_reversal_on_domain",
        "stationary_parameterization_status",
        "base_curve_singularity_classification",
        "isolated_cusp_roots_t",
        "isolated_self_intersections",
        "max_geometric_deviation_bound_cm",
        "max_certified_radial_error_cm",
        "max_subdivision_depth_reached",
        "primary_span_coverage_ratio",
        "local_self_intersection_status",
        "global_contour_self_intersection_status",
        "unresolved_intervals",
        "escalation_trace",
        "verification_outcome",
        "failure_category",
        "detected_failure_categories",
        "canonical_offset_classification",
        "active_classifications_on_domain",
        "working_precision_bits",
        "is_production_ready"
      ],
      "additionalProperties": false,
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "piece_id": { "type": "string", "minLength": 1 },
        "contour_orientation": { "type": "string", "enum": ["CCW_EXTERIOR", "CW_CUTOUT"] },
        "coordinate_convention": { "const": "CARTESIAN_RH_CCW" },
        "offset_direction_sign_s": { "type": "integer", "enum": [-1, 1] },
        "offset_distance_cm": { "type": "number", "minimum": 0.0 },
        "regularity_margin_epsilon": { "type": "number", "minimum": 0.05, "maximum": 0.5 },
        "min_base_speed_squared_interval": {
          "type": "array",
          "prefixItems": [{ "type": "number", "minimum": 0.0 }, { "type": "number", "minimum": 0.0 }],
          "minItems": 2,
          "maxItems": 2
        },
        "min_offset_speed_factor_interval": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "has_zero_speed_cusp_on_domain": { "type": "boolean" },
        "has_tangent_reversal_on_domain": { "type": "boolean" },
        "stationary_parameterization_status": { "$ref": "#/$defs/StationaryParameterizationStatus" },
        "base_curve_singularity_classification": { "$ref": "#/$defs/BaseCurveSingularityClassification" },
        "isolated_cusp_roots_t": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "isolated_self_intersections": {
          "type": "array",
          "items": { "$ref": "#/$defs/SelfIntersectionCertificate" }
        },
        "max_geometric_deviation_bound_cm": { "type": "number", "minimum": 0.0 },
        "max_certified_radial_error_cm": { "type": ["number", "null"], "minimum": 0.0 },
        "max_subdivision_depth_reached": { "type": "integer", "minimum": 0, "maximum": 64 },
        "primary_span_coverage_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "local_self_intersection_status": {
          "type": "string",
          "enum": ["NONE", "DETECTED", "UNRESOLVED", "NOT_EVALUATED"]
        },
        "global_contour_self_intersection_status": {
          "type": "string",
          "enum": ["NONE", "DETECTED", "UNRESOLVED", "NOT_EVALUATED"]
        },
        "unresolved_intervals": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "escalation_trace": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verification_outcome": {
          "type": "string",
          "enum": ["CERTIFIED_VALID", "CERTIFIED_INVALID", "INCONCLUSIVE"]
        },
        "failure_category": { "$ref": "#/$defs/OffsetFailureCategory" },
        "detected_failure_categories": {
          "type": "array",
          "items": { "$ref": "#/$defs/OffsetFailureCategory" }
        },
        "canonical_offset_classification": { "$ref": "#/$defs/CanonicalOffsetClassification" },
        "active_classifications_on_domain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/CanonicalOffsetClassification" }
        },
        "working_precision_bits": { "type": "integer", "minimum": 53, "maximum": 336 },
        "is_production_ready": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verification_outcome": { "const": "CERTIFIED_VALID" } },
            "required": ["verification_outcome"]
          },
          "then": {
            "properties": {
              "failure_category": { "const": "NONE" },
              "canonical_offset_classification": { "const": "CERTIFIED_VALID" },
              "active_classifications_on_domain": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "const": "CERTIFIED_VALID" }
              },
              "detected_failure_categories": {
                "type": "array",
                "items": { "const": "NONE" }
              },
              "primary_span_coverage_ratio": { "const": 1.0 },
              "stationary_parameterization_status": {
                "enum": [
                  "NONE_REGULAR_SPEED",
                  "REMOVABLE_PARAMETERIZATION_DEGENERACY",
                  "ENDPOINT_TANGENTIAL_DEGENERACY"
                ]
              },
              "base_curve_singularity_classification": {
                "enum": [
                  "REGULAR_BASE_CURVE",
                  "REMOVABLE_PARAMETERIZATION_DEGENERACY",
                  "ENDPOINT_TANGENTIAL_DEGENERACY"
                ]
              },
              "isolated_cusp_roots_t": { "maxItems": 0 },
              "isolated_self_intersections": { "maxItems": 0 },
              "unresolved_intervals": { "maxItems": 0 },
              "has_zero_speed_cusp_on_domain": { "const": false },
              "has_tangent_reversal_on_domain": { "const": false },
              "min_offset_speed_factor_interval": {
                "type": "array",
                "prefixItems": [
                  { "type": "number", "minimum": 0.05 },
                  { "type": "number", "minimum": 0.05 }
                ]
              },
              "local_self_intersection_status": { "const": "NONE" },
              "global_contour_self_intersection_status": { "enum": ["NONE", "NOT_EVALUATED"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification_outcome": { "const": "CERTIFIED_VALID" },
              "regularity_margin_epsilon": { "minimum": 0.1 }
            },
            "required": ["verification_outcome", "regularity_margin_epsilon"]
          },
          "then": {
            "properties": {
              "min_offset_speed_factor_interval": {
                "prefixItems": [{ "minimum": 0.1 }, { "minimum": 0.1 }]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "verification_outcome": { "const": "CERTIFIED_INVALID" } },
            "required": ["verification_outcome"]
          },
          "then": {
            "properties": {
              "failure_category": {
                "not": { "enum": ["NONE", "INCONCLUSIVE_VERIFICATION"] }
              },
              "canonical_offset_classification": {
                "not": { "enum": ["CERTIFIED_VALID", "INCONCLUSIVE"] }
              },
              "is_production_ready": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": { "verification_outcome": { "const": "INCONCLUSIVE" } },
            "required": ["verification_outcome"]
          },
          "then": {
            "properties": {
              "failure_category": { "const": "INCONCLUSIVE_VERIFICATION" },
              "canonical_offset_classification": { "const": "INCONCLUSIVE" },
              "active_classifications_on_domain": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "const": "INCONCLUSIVE" }
              },
              "is_production_ready": { "const": false }
            }
          }
        }
      ]
    },
    "OffsetClassificationReport": {
      "type": "object",
      "description": "ADR-009 §5.3 Offset Classification Report. JSON Schema enforces all structural, enum, and discrete conditional certification states; runtime consumers MUST additionally enforce gridErrorCm <= certifiedIntervalErrorCm via Pydantic v2 or packages/contracts/src/cross-field-validators.ts.",
      "x-crossFieldNumericInvariants": [
        "gridErrorCm <= certifiedIntervalErrorCm"
      ],
      "required": [
        "segmentId",
        "canonicalOffsetClassification",
        "activeClassificationsOnDomain",
        "baseCurveSingularityClassification",
